{
  "name": "Ayomide Studio",
  "short_name": "Ayomide",
  "description": "Terminal-flavoured studio PWA: chat, files, image editing, image-to-video, sync — works offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#050807",
  "theme_color": "#050807",
  "categories": ["productivity", "photo", "utilities"],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "video/*", "audio/*", "text/*", "application/pdf"] },
        { "name": "media", "accept": ["image/*", "video/*"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".svg"]
      },
      "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "Chat",
      "url": "./#chat",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Make a video",
      "short_name": "Video",
      "url": "./#video",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI image generator",
      "short_name": "AI image",
      "url": "./#tools",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
