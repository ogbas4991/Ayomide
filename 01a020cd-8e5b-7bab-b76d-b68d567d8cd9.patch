+/* ============================================================
+   Ayomide Studio — TERMINAL SHELL edition
+   mono type · neon-on-black · window chrome · scanlines
+   ============================================================ */
+:root {
+  --bg: #050807;
+  --bg2: #080d0b;
+  --card: #0a100e;
+  --card2: #0d1512;
+  --border: #1c2b25;
+  --border2: #274237;
+  --text: #c9f7e4;
+  --muted: #5e8d7a;
+  --acc: #00ff9c;
+  --acc-dim: rgba(0, 255, 156, .14);
+  --acc2: #4cc9f0;
+  --grad: linear-gradient(90deg, #00ff9c, #4cc9f0);
+  --ok: #00ff9c;
+  --warn: #ffc857;
+  --danger: #ff5f56;
+  --radius: 4px;
+  --shadow: 0 0 0 1px rgba(0, 0, 0, .8), 0 14px 40px rgba(0, 0, 0, .55);
+  --mono: ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", "Fira Code",
+    "Roboto Mono", Consolas, "DejaVu Sans Mono", Menlo, monospace;
+  --glow: 0 0 14px rgba(0, 255, 156, .18);
+}
+
+* { box-sizing: border-box; }
+html, body { height: 100%; }
+body {
+  margin: 0;
+  font-family: var(--mono);
+  font-size: 14px;
+  background: var(--bg);
+  color: var(--text);
+  -webkit-font-smoothing: antialiased;
+  overscroll-behavior-y: none;
+}
+/* CRT scanlines + faint glow */
+body::after {
+  content: "";
+  position: fixed; inset: 0; pointer-events: none; z-index: 998;
+  background: repeating-linear-gradient(0deg, rgba(0, 0, 0, .14) 0 1px, transparent 1px 3px);
+  opacity: .3;
+}
+::selection { background: var(--acc); color: #02120b; }
+img { max-width: 100%; }
+button { font: inherit; color: inherit; }
+a { color: var(--acc2); }
+.spacer { flex: 1; }
+.muted { color: var(--muted); font-size: 12.5px; }
+.center { text-align: center; }
+.grow { flex: 1; }
+.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
+
+/* scrollbars */
+::-webkit-scrollbar { width: 10px; height: 10px; }
+::-webkit-scrollbar-track { background: var(--bg2); }
+::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 0; }
+::-webkit-scrollbar-thumb:hover { background: var(--acc); }
+
+/* ---------- window chrome (used on panels/stages) ---------- */
+.panel, .modal, .chat-col, .editor-stage, .video-stage, .dropzone, .tools-grid .tool-card, .settings-grid .card {
+  position: relative;
+  border: 1px solid var(--border);
+  background: var(--card);
+  box-shadow: var(--shadow);
+}
+.panel::before, .chat-col::before, .dropzone::before {
+  content: "● ● ●  ~/ayomide";
+  display: block;
+  padding: 7px 12px;
+  border-bottom: 1px solid var(--border);
+  color: var(--muted);
+  font-size: 10px;
+  letter-spacing: 2px;
+}
+
+/* ---------- layout ---------- */
+#app { display: flex; height: 100dvh; }
+#sidebar {
+  width: 232px; flex: 0 0 auto; display: flex; flex-direction: column;
+  background: var(--bg2); border-right: 1px solid var(--border);
+  padding: 16px 12px; gap: 14px;
+}
+.brand { display: flex; gap: 10px; align-items: center; padding: 4px 6px; }
+.brand img { height: 42px; width: auto; max-width: 120px; object-fit: contain; border-radius: 4px; }
+.brand-text b { display: block; font-size: 14px; letter-spacing: .5px; text-shadow: var(--glow); }
+.brand-text span { font-size: 10.5px; color: var(--muted); }
+
+#side-nav { display: flex; flex-direction: column; gap: 2px; }
+.nav-item {
+  display: flex; align-items: center; gap: 8px; width: 100%;
+  background: none; border: 0; border-left: 2px solid transparent;
+  padding: 9px 10px; color: var(--muted); cursor: pointer;
+  font-size: 13px; text-align: left; letter-spacing: .3px;
+  transition: color .12s, border-color .12s, background .12s;
+}
+.nav-item::before { content: "❯"; font-size: 11px; opacity: .7; }
+.nav-item:hover { color: var(--acc); background: rgba(0, 255, 156, .05); }
+.nav-item.active {
+  color: var(--acc); border-left-color: var(--acc);
+  background: rgba(0, 255, 156, .07); text-shadow: var(--glow);
+}
+.nav-ico { font-size: 15px; }
+
+.side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 10px; }
+.net-status { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted); padding: 0 4px; }
+.net-status .dot { width: 7px; height: 7px; background: var(--ok); box-shadow: 0 0 8px var(--ok); }
+.net-status.offline .dot { background: var(--danger); box-shadow: 0 0 8px var(--danger); }
+
+#main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
+#topbar {
+  display: flex; align-items: center; gap: 10px; padding: 10px 18px;
+  border-bottom: 1px solid var(--border);
+  background: rgba(8, 13, 11, .88);
+  position: sticky; top: 0; z-index: 5;
+}
+#topbar-logo { display: none; width: 24px; height: 24px; image-rendering: pixelated; }
+#view-title { font-size: 15px; margin: 0; font-weight: 700; letter-spacing: .5px; }
+#view-title::after {
+  content: "▊"; color: var(--acc); animation: blink 1.1s steps(2, start) infinite;
+  margin-left: 4px; text-shadow: var(--glow);
+}
+@keyframes blink { to { visibility: hidden; } }
+
+.view { display: none; flex: 1; min-height: 0; padding: 18px 20px; overflow-y: auto; }
+.view.active { display: block; }
+#view-chat.active { display: flex; flex-direction: column; }
+
+/* ---------- buttons ---------- */
+.btn {
+  background: transparent; border: 1px solid var(--border2); color: var(--text);
+  border-radius: var(--radius); padding: 8px 13px; cursor: pointer;
+  font-size: 13px; letter-spacing: .3px;
+  transition: border-color .12s, color .12s, box-shadow .12s, background .12s;
+}
+.btn:hover { border-color: var(--acc); color: var(--acc); box-shadow: var(--glow); }
+.btn:disabled { opacity: .4; cursor: not-allowed; box-shadow: none; }
+.btn.primary { background: var(--acc); border-color: var(--acc); color: #02120b; font-weight: 700; }
+.btn.primary:hover { color: #02120b; filter: brightness(1.12); box-shadow: 0 0 18px rgba(0, 255, 156, .35); }
+.btn.ghost { border-style: dashed; }
+.btn.ok { border-color: var(--ok); color: var(--ok); }
+.btn.warn { border-color: var(--warn); color: var(--warn); }
+.btn.danger { border-color: var(--danger); color: var(--danger); }
+.btn.big { width: 100%; padding: 12px; font-size: 14px; }
+.btn.block { width: 100%; }
+.btn.slim { padding: 5px 9px; font-size: 12px; }
+.btn-row { display: flex; gap: 8px; margin: 10px 0; flex-wrap: wrap; }
+.btn-row.wrap { flex-wrap: wrap; }
+.icon-btn {
+  background: var(--bg); border: 1px solid var(--border2); border-radius: var(--radius);
+  width: 38px; height: 38px; cursor: pointer; font-size: 15px; flex: 0 0 auto;
+}
+.icon-btn:hover { border-color: var(--acc); box-shadow: var(--glow); }
+
+input[type="text"], input[type="search"], input[type="url"], input[type="password"],
+input[type="number"], input[type="email"], select, textarea {
+  background: var(--bg); border: 1px solid var(--border2); color: var(--text);
+  border-radius: var(--radius); padding: 8px 11px; font-size: 13px; outline: none;
+  width: 100%; font-family: var(--mono); caret-color: var(--acc);
+}
+input::placeholder, textarea::placeholder { color: var(--muted); opacity: .8; }
+input:focus, select:focus, textarea:focus { border-color: var(--acc); box-shadow: var(--glow); }
+input[type="range"] { width: 100%; accent-color: var(--acc); padding: 0; border: 0; background: none; }
+input[type="color"] { width: 44px; height: 32px; padding: 2px; border-radius: 4px; cursor: pointer; background: var(--bg); border: 1px solid var(--border2); }
+input[type="checkbox"] { accent-color: var(--acc); width: 15px; height: 15px; }
+label.check { display: flex; gap: 8px; align-items: center; font-size: 13px; margin: 8px 0; cursor: pointer; }
+label.field { display: block; font-size: 12px; color: var(--muted); margin: 10px 0; text-transform: lowercase; }
+label.field input, label.field select { margin-top: 6px; }
+label.inline { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
+
+#bottomnav { display: none; }
+
+/* panel section headers: ── title ── */
+.panel h3 {
+  margin: 16px 0 8px; font-size: 11px; text-transform: uppercase; letter-spacing: .18em;
+  color: var(--muted); display: flex; align-items: center; gap: 8px;
+}
+.panel h3::after { content: ""; flex: 1; border-top: 1px dashed var(--border2); }
+.panel h3:first-of-type { margin-top: 8px; }
+.panel { padding: 12px 16px 16px; position: sticky; top: 76px; }
+
+/* ---------- chat ---------- */
+#view-chat { padding: 0; }
+.chat-col { display: flex; flex-direction: column; flex: 1; min-height: 0; }
+#chat-thread-bar { display: flex; gap: 8px; padding: 12px 18px 0; align-items: center; }
+#chat-thread-bar select { flex: 1; min-width: 0; }
+
+.chat-scroll { flex: 1; overflow-y: auto; padding: 16px 18px 6px; }
+.chat-list { display: flex; flex-direction: column; gap: 12px; max-width: 860px; margin: 0 auto; width: 100%; }
+.msg { display: flex; gap: 10px; max-width: 88%; }
+.msg .avatar {
+  width: 32px; height: 32px; flex: 0 0 auto;
+  display: flex; align-items: center; justify-content: center; font-size: 16px;
+  background: var(--bg); border: 1px solid var(--border2); border-radius: var(--radius);
+}
+.msg .avatar.user { border-style: dashed; }
+.msg .bubble {
+  background: var(--card); border: 1px solid var(--border);
+  border-left: 2px solid var(--acc);
+  border-radius: var(--radius);
+  padding: 9px 13px; font-size: 13.5px; line-height: 1.55; overflow-wrap: anywhere;
+}
+.msg .bubble::before {
+  content: attr(data-prompt);
+  display: block; font-size: 10px; color: var(--muted); letter-spacing: .08em; margin-bottom: 5px;
+}
+.msg.user .bubble { border-left: 2px solid var(--acc2); background: #081318; }
+.msg .bubble img { border-radius: 4px; max-height: 240px; display: block; margin-top: 8px; border: 1px solid var(--border); }
+.msg .meta { font-size: 10.5px; color: var(--muted); margin-top: 4px; }
+.msg.user { align-self: flex-end; align-items: flex-end; flex-direction: row-reverse; }
+.msg .actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
+.msg .actions button {
+  background: transparent; border: 1px dashed var(--border2);
+  color: var(--acc); border-radius: var(--radius); padding: 4px 10px; font-size: 11.5px; cursor: pointer;
+}
+.msg .actions button:hover { border-color: var(--acc); box-shadow: var(--glow); }
+.msg.typing .bubble { display: flex; gap: 5px; align-items: center; border-left-color: var(--muted); }
+.msg.typing .dot-b { width: 6px; height: 6px; background: var(--acc); animation: blink 1s steps(2, start) infinite; }
+.msg.typing .dot-b:nth-child(2) { animation-delay: .2s; }
+.msg.typing .dot-b:nth-child(3) { animation-delay: .4s; }
+
+.chat-suggest { display: flex; gap: 8px; padding: 6px 18px; overflow-x: auto; scrollbar-width: none; }
+.chat-suggest::-webkit-scrollbar { display: none; }
+.chat-suggest button {
+  background: transparent; border: 1px dashed var(--border2); color: var(--muted);
+  border-radius: var(--radius); padding: 6px 12px; font-size: 12px; white-space: nowrap; cursor: pointer;
+}
+.chat-suggest button:hover { color: var(--acc); border-color: var(--acc); }
+
+.chat-form { padding: 10px 18px 14px; border-top: 1px solid var(--border); background: var(--bg2); }
+.chat-input-row { display: flex; gap: 8px; max-width: 860px; margin: 0 auto; align-items: center; }
+.prompt-wrap {
+  flex: 1; display: flex; align-items: center; gap: 8px;
+  background: var(--bg); border: 1px solid var(--border2); border-radius: var(--radius);
+  padding: 0 10px; min-width: 0;
+}
+.prompt-wrap:focus-within { border-color: var(--acc); box-shadow: var(--glow); }
+.prompt-wrap .ps1 { color: var(--acc); font-weight: 700; }
+.prompt-wrap input { border: 0; background: none; padding: 10px 0; flex: 1; min-width: 0; box-shadow: none; }
+.send-btn {
+  background: var(--acc); border: 1px solid var(--acc); color: #02120b; width: 40px; height: 40px;
+  border-radius: var(--radius); cursor: pointer; font-size: 15px; flex: 0 0 auto; font-weight: 700;
+}
+.send-btn:hover { filter: brightness(1.12); box-shadow: 0 0 16px rgba(0, 255, 156, .4); }
+#chat-mic.listening { border-color: var(--danger); color: var(--danger); animation: pulse 1.2s infinite; }
+#chat-tts.on { border-color: var(--acc); color: var(--acc); box-shadow: var(--glow); }
+.chat-attach-box { position: relative; width: 74px; margin-bottom: 8px; }
+.chat-attach-box img { width: 74px; height: 74px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border2); }
+.chat-attach-box button {
+  position: absolute; top: -7px; right: -7px; width: 22px; height: 22px; border-radius: 50%;
+  border: 1px solid var(--danger); background: var(--bg); color: var(--danger); cursor: pointer; font-size: 11px;
+}
+
+/* ---------- files ---------- */
+.dropzone {
+  border: 1px dashed var(--border2); padding: 22px; text-align: center;
+  transition: border-color .15s, box-shadow .15s;
+}
+.dropzone.drag { border-color: var(--acc); box-shadow: var(--glow); background: var(--acc-dim); }
+.dz-icon { font-size: 30px; }
+.dz-inner p { color: var(--muted); margin: 8px 0 12px; }
+
+.toolbar { display: flex; gap: 10px; align-items: center; margin: 16px 0; flex-wrap: wrap; }
+.toolbar input[type="search"] { max-width: 240px; }
+.toolbar select { width: auto; }
+
+.files-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: 12px; }
+.file-card {
+  background: var(--card); border: 1px solid var(--border);
+  overflow: hidden; display: flex; flex-direction: column;
+  transition: border-color .15s, box-shadow .15s;
+}
+.file-card:hover { border-color: var(--acc); box-shadow: var(--glow); }
+.file-thumb {
+  height: 104px; background: var(--bg); display: flex; align-items: center; justify-content: center;
+  font-size: 32px; cursor: pointer; position: relative;
+  border-bottom: 1px solid var(--border);
+}
+.file-thumb img { width: 100%; height: 100%; object-fit: cover; }
+.file-body { padding: 9px 11px; display: flex; flex-direction: column; gap: 6px; }
+.file-name { font-size: 12.5px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.file-meta { font-size: 10.5px; color: var(--muted); }
+.file-actions { display: flex; gap: 4px; flex-wrap: wrap; }
+.file-actions button {
+  background: transparent; border: 1px solid var(--border2); color: var(--muted);
+  border-radius: 3px; padding: 3px 7px; font-size: 11px; cursor: pointer;
+}
+.file-actions button:hover { color: var(--acc); border-color: var(--acc); }
+
+.empty { text-align: center; color: var(--muted); padding: 40px 16px; }
+.empty-icon { font-size: 40px; margin-bottom: 10px; }
+.empty p { line-height: 1.7; }
+.empty .row { justify-content: center; margin-top: 14px; }
+
+/* chips & bulk */
+.chip-row { display: flex; gap: 6px; flex-wrap: wrap; margin: 10px 0; }
+.chip-row:empty { display: none; }
+.chip { background: transparent; border: 1px dashed var(--border2); color: var(--muted); border-radius: var(--radius); padding: 4px 11px; font-size: 11.5px; cursor: pointer; }
