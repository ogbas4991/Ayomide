+# One-click deploy of the Ayomide Studio sync server (+ site) to Render:
+#   1. Push this repo to GitHub
+#   2. Open https://render.com/deploy and paste your repo URL (or use the button in the README)
+# Note: Render's free plan has an ephemeral filesystem — data resets on redeploy.
+# For persistent storage use Railway or Fly.io with a volume, or a paid Render disk.
+services:
+  - type: web
+    name: ayomide-studio
+    runtime: node
+    plan: free
+    buildCommand: echo "no build needed"
+    startCommand: node server/index.js
+    healthCheckPath: /api/health
+    envVars:
+      - key: NODE_VERSION
+        value: 20
