+      for (const b of blobs.slice(0, 6)) {
+        const url = URL.createObjectURL(b);
+        imgs.push(await loadImage(url));
+        URL.revokeObjectURL(url);
+      }
+      toast(`${imgs.length} image(s) loaded`, 'ok');
+    };
