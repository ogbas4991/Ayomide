+function cutoutBackground() {
+  if (!st) { toast('Load an image first ✨', 'warn'); return; }
+  const c = baseOutCanvas();
+  const ctx = c.getContext('2d');
+  const W = c.width, H = c.height;
+  const img = ctx.getImageData(0, 0, W, H);
+  const d = img.data;
